{
  "name": "my-lifts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "reset-password": "NODE_NO_WARNINGS=1 tsx scripts/reset-password.ts",
    "dev:local": "vite --mode local",
    "build:local": "vite build --mode local"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.18",
    "hono": "^4.13.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
